{
  "name": "dsh-latex-preview",
  "version": "0.0.0",
  "private": true,
  "description": "LaTeX Preview: live PDF preview, SyncTeX jumps, and one-click compile-error hand-off for DSH",
  "author": "Tianshang301",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "assets",
    "i18n",
    "cordis.patch.yml"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.2-rc.5"
  },
  "scripts": {
    "assets": "node scripts/build-assets.mjs",
    "binaries": "tsx scripts/check-binaries.ts",
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs && node scripts/build-assets.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "tsx --test test/unit/*.test.ts",
    "verify": "tsx test/contract/probe.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "chokidar": "3.6.0",
    "diff-match-patch": "1.0.5",
    "pdfjs-dist": "4.10.38"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@types/diff-match-patch": "1.0.36",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.24.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
